[Unit]
Description=GenLayer Bradbury explorer api
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=pathrock
Group=pathrock
Type=simple
WorkingDirectory=/opt/pathrock/explorers/genlayer-bradbury/current/packages/api
EnvironmentFile=/etc/opt/pathrock/genlayer-bradbury.env
Environment=PATH=/opt/pathrock/runtime/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/opt/pathrock/runtime/home
ExecStart=/opt/pathrock/runtime/node/bin/node --import tsx src/server.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=genlayer-bradbury-api

[Install]
WantedBy=multi-user.target
