[Unit]
Description=GenLayer Explorer API + web
After=network-online.target postgresql.service
Wants=network-online.target
# Keep retrying rather than hitting the default start-limit and giving up.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/pathrock/explorers/genlayer-bradbury/current/packages/api
EnvironmentFile=/opt/pathrock/explorers/genlayer-bradbury/current/.env
# Node comes from nvm on this host; adjust if Node is installed elsewhere.
Environment=PATH=/opt/pathrock/runtime/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/pathrock/explorers/genlayer-bradbury/current/packages/api/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=5
# Hardening: the API needs no privileges and no writable filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=genlayer-api

[Install]
WantedBy=multi-user.target
