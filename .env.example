# ── GenLayer JSON-RPC endpoints (comma-separated failover list) ─────────────
RPC_URLS=https://genlayer-rpc.pathrocknetwork.org

# Expected chain id; the indexer refuses to start against anything else.
# CHAIN_ID=4221
# Request budget per second: indexer / API (separate processes, separate buckets).
# RPC_RPS=10
# API_RPC_RPS=10

# ── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://genlayer:CHANGE_ME@localhost:5432/genlayer_explorer

# ── Indexer ─────────────────────────────────────────────────────────────────
# Blocks and transactions are kept from genesis when RETAIN_HOURS=0; the
# default rolling window suits high-throughput chains.
# BACKFILL_DEPTH=30000
# RETAIN_HOURS=72
# FETCH_CONCURRENCY=4

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3005
# Interface to bind. Defaults to 127.0.0.1 so the API is never published directly.
# API_HOST=127.0.0.1
